{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Esperanto",
  "version": "0.1.0",
  "identifier": "com.mdiazn80.esperanto",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Esperanto",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 24
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/Assets.car"
    ],
    "macOS": {
      "minimumSystemVersion": "14.4",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "./locales/en.lproj/InfoPlist.strings",
        "Resources/es.lproj/InfoPlist.strings": "./locales/es.lproj/InfoPlist.strings"
      }
    }
  }
}
